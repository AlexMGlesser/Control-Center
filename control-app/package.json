{
  "name": "control-center-control-app",
  "version": "1.0.0",
  "private": true,
  "author": "Alex Glesser",
  "description": "Control Center host app with UI-first shell and backend integration stubs",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "start:web": "node server/index.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable nsis"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.7.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.alexmglesser.controlcenter",
    "productName": "Control Center",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "icon": "build/icon.ico",
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/**/*",
      "agent/**/*",
      "voice/**/*",
      "build/icon.ico",
      ".env.example",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "agent/AGENT_TOOL_CONTEXT.txt",
        "to": "agent/AGENT_TOOL_CONTEXT.txt"
      },
      {
        "from": "../calendar-app",
        "to": "apps/calendar-app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../news-app",
        "to": "apps/news-app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../work-app",
        "to": "apps/work-app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../project-app",
        "to": "apps/project-app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../music-app",
        "to": "apps/music-app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../drawing-app",
        "to": "apps/drawing-app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../movie-app",
        "to": "apps/movie-app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../server-manager-app",
        "to": "apps/server-manager-app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../wikipedia-app",
        "to": "apps/wikipedia-app",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../file-system-app",
        "to": "apps/file-system-app",
        "filter": [
          "**/*",
          "!dataset/**",
          "!gesture_profiles/**",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../design-documents",
        "to": "design-documents",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "voice/whisper",
        "to": "voice/whisper",
        "filter": ["**/*"]
      },
      {
        "from": "voice/piper",
        "to": "voice/piper",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable",
        "nsis"
      ],
      "executableName": "Control Center"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Control Center"
    }
  }
}
