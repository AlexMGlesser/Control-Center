OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

CALENDAR_TIMEZONE=America/Los_Angeles

# Wikipedia App (offline Wikipedia librarian, a Python server Control Center
# starts on demand). WIKIPEDIA_DATA_DIR is the "organized" folder holding
# en/enwiki.sqlite + en/search_index.sqlite; it is opened read-only, in place.
WIKIPEDIA_DATA_DIR=D:\Glesser-Industries-Database\Wikipedia\organized
WIKIPEDIA_PYTHON=python
WIKIPEDIA_LIBRARIAN_PORT=8766
# Model for the librarian's own /agent page; defaults to OLLAMA_MODEL so only one model loads.
# WIKIPEDIA_LIBRARIAN_MODEL=qwen3.5:9b
# Archive is on a hard drive; cold searches can take over a minute.
# WIKIPEDIA_REQUEST_TIMEOUT_MS=150000
