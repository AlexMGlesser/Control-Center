OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

CALENDAR_TIMEZONE=America/Los_Angeles

# Wikipedia App (offline Wikipedia librarian, a Python server Control Center
# starts on demand). WIKIPEDIA_DATA_DIR is the "organized" folder holding
# en/enwiki.sqlite + en/search_index.sqlite; it is opened read-only, in place.
WIKIPEDIA_DATA_DIR=D:\Glesser-Industries-Database\Wikipedia\organized
WIKIPEDIA_PYTHON=python
WIKIPEDIA_LIBRARIAN_PORT=8766
# Model for the librarian's own /agent page; defaults to OLLAMA_MODEL so only one model loads.
# WIKIPEDIA_LIBRARIAN_MODEL=qwen3.5:9b

# File System App (native Python). Interpreter used to launch file_explorer.py
# and gesture_recorder.py; needs mediapipe, opencv-python, numpy, Pillow
# (see file-system-app/requirements.txt). Leave empty to auto-pick: the first of
# file-system-app/.venv, the py-launcher Python, or python on PATH that has those
# packages (its pythonw.exe is used, so no console window). Set a full path to
# force one; it's still checked for the packages.
FILE_SYSTEM_PYTHON=
# Where calibration profiles and recorded gesture datasets live. Default: the
# file-system-app folder in dev, %APPDATA%/Control Center/file-system-app
# in the packaged app.
FILE_SYSTEM_DATA_DIR=

# The phone's IDE app edits files in this folder. Default: scripts/ at the
# repo root in dev, %APPDATA%/Control Center/scripts in the packaged app.
CC_SCRIPTS_DIR=

# ArtCraft creative apps (getartcraft.com) that Jarvis can open and use;
# each app lives in <ARTCRAFT_DIR>\apps\<Name>\ with <name>.exe and <name>-cli.exe.
ARTCRAFT_DIR=D:\ArtCraft
